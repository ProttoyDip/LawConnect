# Frontend Environment Variables for LawConnect
# Copy this file to .env.local or .env and customize for your environment
# Vite exposes env vars prefixed with VITE_ to the client

# Backend API endpoint
# Leave empty for local development so Vite proxy handles /api requests.
# Set this only for production builds when frontend and backend are on different origins.
# Example: https://my-backend.onrender.com
VITE_BACKEND_ENDPOINT=

# Optional compatibility alias. If VITE_BACKEND_ENDPOINT is set, it takes precedence.
VITE_API_URL=

# App configuration
VITE_APP_TITLE=LawConnect
VITE_APP_DESCRIPTION=AI-Powered Crime Reporting System

# Optional: API keys or other services
# VITE_MAPS_API_KEY=your_maps_key
# VITE_ANALYTICS_ID=your_analytics_id
